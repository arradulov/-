{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DroneRLDb_v2;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "RecreateDatabaseOnStartup": false,
  "Jwt": {
    "Issuer": "DroneRL_backend",
    "Audience": "DroneRL_clients",
    "Key": "DroneRL-lab-secret-key-must-be-at-least-32-bytes-long!",
    "LifetimeMinutes": 120
  },
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
